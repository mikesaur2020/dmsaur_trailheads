# submit-idea — local-only env for `supabase functions serve`.
#
# Copy this file to `.env` (which is gitignored) before serving locally:
#   cp supabase/functions/submit-idea/.env.example supabase/functions/submit-idea/.env
#   supabase functions serve submit-idea --no-verify-jwt \
#     --env-file supabase/functions/submit-idea/.env
#
# TURNSTILE_SECRET_KEY below is Cloudflare's PUBLIC, well-known Turnstile *test*
# secret (it always passes verification). It is NOT a real secret and is safe to
# commit in this example. The real hosted secret is set out-of-band via
#   supabase secrets set TURNSTILE_SECRET_KEY=...
# at deploy time (Gate D) and is NEVER committed or placed in a VITE_ variable.
#
# Cloudflare Turnstile test keys (https://developers.cloudflare.com/turnstile/troubleshooting/testing/):
#   always-passes secret: 1x0000000000000000000000000000000AA
#   always-fails  secret: 2x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Optional production hardening ------------------------------------------
# Leave these UNSET locally so Cloudflare's test keys remain usable. Hostname and
# action are enforced ONLY when set, so setting them in production (Gate D) turns
# on full validation without changing any code path. The Phase 3A.2 widget will
# render with action = "submit_idea".
#
# TURNSTILE_EXPECTED_HOSTNAME=trailheads.dmsaur.com
# TURNSTILE_EXPECTED_ACTION=submit_idea
# TURNSTILE_TIMEOUT_MS=5000
#
# TURNSTILE_VERIFY_URL overrides Cloudflare's Siteverify endpoint. Leave UNSET in
# real use; it exists only so tests can point at a mock server.
# TURNSTILE_VERIFY_URL=

# NOTE: SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by
# the Supabase CLI when serving/deploying functions. Do NOT set them here, and
# never expose the service_role key to the browser.
